{
  "name": "porch-pile",
  "version": "0.1.0",
  "private": true,
  "description": "Porch Pile: track every product, video, brand deal and dollar for Amazon Influencer creators. Cloudflare Worker + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "test:security": "node scripts/test-security.mjs",
    "test:import": "node --test tests/import-lib.test.mjs",
    "test:nudges": "node tests/nudges.test.mjs",
    "test:ratelimit": "node --test --test-force-exit tests/ratelimit.test.mjs",
    "test:webhook": "node --test --test-force-exit tests/webhook-retry.test.mjs",
    "test:flags": "node --test --test-force-exit tests/site-flags.test.mjs",
    "test:auth": "node --test --test-force-exit tests/auth-limits.test.mjs",
    "predeploy": "node scripts/test-security.mjs && node tests/nudges.test.mjs && node --test --test-force-exit tests/webhook-retry.test.mjs && node --test --test-force-exit tests/auth-limits.test.mjs",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply porch-pile --local",
    "migrate:remote": "wrangler d1 migrations apply porch-pile --remote"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Jen Soltys",
  "homepage": "https://porchpile.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jensoltys/porchpile.git"
  },
  "bugs": {
    "url": "https://github.com/jensoltys/porchpile/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
